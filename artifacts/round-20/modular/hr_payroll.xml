<root alias_model_name="hr_payroll"
      cfg_mask_china_mobile="false"
      chinese_name="人力资源工资管理"
      english_name="HR Payroll"
      data_service="sqlite"
      name="hr-payroll-service"
      org="doublechaintech"
      _module_key="root">
  <employee_record _name="Employee Record"
                   _module="HR Payroll"
                   _module_key="hr-payroll"
                   employee_number="string()"
                   first_name="string()"
                   last_name="string()"
                   hire_date="date()"
                   department="string()"
                   employment_status="string()"/>
  <payroll_run _name="Payroll Run"
               _module="HR Payroll"
               _module_key="hr-payroll"
               payroll_period_start="date()"
               payroll_period_end="date()"
               run_date="date()"
               status="string()"/>
  <timesheet_entry _name="Timesheet Entry"
                   _module="HR Payroll"
                   _module_key="hr-payroll"
                   employee="employee_record()"
                   work_date="date()"
                   hours_worked="decimal()"
                   description="string()"/>
  <benefit_plan _name="Benefit Plan"
                _module="HR Payroll"
                _module_key="hr-payroll"
                plan_name="string()"
                provider="string()"
                coverage_type="string()"
                effective_date="date()"/>
  <tax_withholding _name="Tax Withholding"
                   _module="HR Payroll"
                   _module_key="hr-payroll"
                   employee="employee_record()"
                   tax_type="string()"
                   rate="decimal()"
                   effective_date="date()"/>
  <leave_request _name="Leave Request"
                 _module="HR Payroll"
                 _module_key="hr-payroll"
                 employee="employee_record()"
                 leave_type="string()"
                 start_date="date()"
                 end_date="date()"
                 status="string()"/>
  <training_record _name="Training Record"
                   _module="HR Payroll"
                   _module_key="hr-payroll"
                   employee="employee_record()"
                   training_name="string()"
                   completion_date="date()"
                   provider="string()"/>
  <performance_review _name="Performance Review"
                      _module="HR Payroll"
                      _module_key="hr-payroll"
                      employee="employee_record()"
                      reviewer="employee_record()"
                      review_date="date()"
                      rating="decimal()"
                      comments="string()"/>
  <compensation_adjustment _name="Compensation Adjustment"
                           _module="HR Payroll"
                           _module_key="hr-payroll"
                           employee="employee_record()"
                           adjustment_type="string()"
                           amount="decimal()"
                           effective_date="date()"
                           approved_by="employee_record()"/>
  <onboarding_checklist _name="Onboarding Checklist"
                        _module="HR Payroll"
                        _module_key="hr-payroll"
                        employee="employee_record()"
                        task_description="string()"
                        due_date="date()"
                        completed="boolean()"/>
  <offboarding_process _name="Offboarding Process"
                       _module="HR Payroll"
                       _module_key="hr-payroll"
                       employee="employee_record()"
                       process_step="string()"
                       due_date="date()"
                       completed="boolean()"/>
  <employee_handbook _name="Employee Handbook"
                     _module="HR Payroll"
                     _module_key="hr-payroll"
                     version="string()"
                     effective_date="date()"
                     description="string()"/>
</root>